<?xml version="1.0" encoding="utf-8" ?>
<sqlMap namespace="Dmstatus" xmlns="http://ibatis.apache.org/mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <alias>
      <typeAlias alias="Dmstatus" type="CoreNET.Common.BO.DmstatusControl" />
    </alias>
    <resultMaps>
      <resultMap id="return-result" class="Dmstatus">
        <result property="Ketstatus" column="KETSTATUS"/>
        <result property="Nmstatus" column="NMSTATUS"/>
        <result property="Statusicon" column="STATUSICON"/>
        <result property="Last_by" column="LAST_BY"/>
        <result property="Last_date" column="LAST_DATE"/>
        <result property="Idstatus" column="IDSTATUS"/>
      </resultMap>
      <resultMap id="return-result-lookup" class="Dmstatus">
        <result property="Nmstatus" column="NMSTATUS"/>
        <result property="Statusicon" column="STATUSICON"/>
        <result property="Idstatus" column="IDSTATUS"/>
      </resultMap>
    </resultMaps>
    <statements>
      <insert id="InsertDmstatus" parameterMap="insert-param">
        <generate table="Dmstatus"/>
      </insert>
      <update id="UpdateByDmstatus" parameterMap="update-param">
        <generate table="Dmstatus" by="IDSTATUS"/>
      </update>
      <delete id="DeleteByDmstatus" parameterMap="delete-param">
        <generate table="Dmstatus" by="IDSTATUS"/>
      </delete>
      <select id="BaseQueryDmstatus" parameterClass="Dmstatus" resultMap="return-result">
        select D.IDSTATUS,rtrim(D.NMSTATUS) as NMSTATUS,rtrim(D.STATUSICON) as STATUSICON,rtrim(D.KETSTATUS) as KETSTATUS
        ,rtrim(D.LAST_BY) as LAST_BY,D.LAST_DATE
        from DMSTATUS D
      </select>
      <select id="QueryByAllDmstatus" extends="BaseQueryDmstatus" parameterClass="Dmstatus" resultMap="return-result">
        where 1=1
        <![CDATA[and D.IDSTATUS < 10]]>
        order by D.IDSTATUS
      </select>
      <select id="QueryByDmstatus" extends="BaseQueryDmstatus" parameterClass="Dmstatus" resultMap="return-result">
        where 1=1
        and D.IDSTATUS in (-1,0,1)
        order by D.IDSTATUS
      </select>
      <select id="QueryByDiterimaDmstatus" parameterClass="Dmstatus" resultMap="return-result-lookup">
        select -1 as IDSTATUS,'Batal' as NMSTATUS,'buletmerah.png' as STATUSICON
        union
        select 0 as IDSTATUS,'Dalam Proses' as NMSTATUS,'buletkuning.png' as STATUSICON
        union
        select 1 as IDSTATUS,'Diterima' as NMSTATUS,'buletbiru.png' as STATUSICON
      </select>
      <select id="QueryByProsesDmstatus" parameterClass="Dmstatus" resultMap="return-result-lookup">
        select -1 as IDSTATUS,'Batal' as NMSTATUS,'buletmerah.png' as STATUSICON
        union
        select 0 as IDSTATUS,'Dalam Proses' as NMSTATUS,'buletkuning.png' as STATUSICON
        union
        select 1 as IDSTATUS,'Proses Selesai' as NMSTATUS,'buletbiru.png' as STATUSICON
      </select>
      <select id="QueryByTpDmstatus" parameterClass="Dmstatus" resultMap="return-result-lookup">
        select -1 as IDSTATUS,'Batal' as NMSTATUS,'buletmerah.png' as STATUSICON
        union
        select 0 as IDSTATUS,'Belum Ditindaklanjuti' as NMSTATUS,'buletkuning.png' as STATUSICON
        union
        select 1 as IDSTATUS,'Sudah Ditindaklanjuti' as NMSTATUS,'buletbiru.png' as STATUSICON
      </select>
      <select id="QueryByMasaDmstatus" parameterClass="Dmstatus" resultMap="return-result-lookup">
        select -1 as IDSTATUS,'Batal' as NMSTATUS,'buletmerah.png' as STATUSICON
        union
        select 0 as IDSTATUS,'Belum Pernah' as NMSTATUS,'buletkuning.png' as STATUSICON
        union
        select 1 as IDSTATUS,'Sudah Pernah' as NMSTATUS,'buletbiru.png' as STATUSICON
        union
        select 2 as IDSTATUS,'Sedang Berlangsung' as NMSTATUS,'buletnavy.png' as STATUSICON
      </select>
      <select id="QueryByTetapDmstatus" parameterClass="Dmstatus" resultMap="return-result-lookup">
        select -1 as IDSTATUS,'Refresh' as NMSTATUS,'buletmerah.png' as STATUSICON
        union
        select 0 as IDSTATUS,'Tidak Ditetapkan' as NMSTATUS,'buletkuning.png' as STATUSICON
        union
        select 1 as IDSTATUS,'Ditetapkan' as NMSTATUS,'buletbiru.png' as STATUSICON
      </select>
      <select id="QueryByLookupDmstatus" extends="BaseQueryDmstatus" parameterClass="Dmstatus" resultMap="return-result">
        where 1=1
        order by D.IDSTATUS
      </select>
      <select id="LoadByPKDmstatus" extends="BaseQueryDmstatus" parameterClass="Dmstatus" resultMap="return-result">
        where D.IDSTATUS = #Idstatus#
      </select>
      <select id="LoadByKeyDmstatus" extends="BaseQueryDmstatus" parameterClass="Dmstatus" resultMap="return-result">
        where D.NMSTATUS = #Nmstatus#
      </select>
    </statements>
    <parameterMaps>
      <parameterMap id="insert-param" class="Dmstatus">
        <parameter property="Statusicon" column="STATUSICON"/>
        <parameter property="Nmstatus" column="NMSTATUS"/>
        <parameter property="Last_by" column="LAST_BY"/>
        <parameter property="Last_date" column="LAST_DATE"/>
        <parameter property="Idstatus" column="IDSTATUS"/>
      </parameterMap>
      <parameterMap id="update-param" extends="insert-param" class="Dmstatus">
      </parameterMap>
      <parameterMap id="delete-param" class="Dmstatus">
        <parameter property="Idstatus" column="IDSTATUS"/>
      </parameterMap>
    </parameterMaps>
</sqlMap>

