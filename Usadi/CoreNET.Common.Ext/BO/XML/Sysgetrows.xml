<?xml version="1.0" encoding="utf-8" ?>
<sqlMap namespace="Sysgetrows" xmlns="http://ibatis.apache.org/mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <alias>
      <typeAlias alias="Sysgetrows" type="CoreNET.Common.BO.SysgetrowsControl" />
    </alias>
    <resultMaps>
      <resultMap id="return-result" class="Sysgetrows">
        <result property="Rowtype" column="ROWTYPE"/>
        <result property="Rowwidth" column="ROWWIDTH"/>
        <result property="Rowenable" column="ROWENABLE"/>
        <result property="Roweditable" column="ROWEDITABLE"/>
        <result property="Rowavaillist" column="ROWAVAILLIST"/>
        <result property="Nourut" column="NOURUT"/>
        <result property="Typename" column="TYPENAME"/>
        <result property="Rowname" column="ROWNAME"/>
      </resultMap>
    </resultMaps>
    <statements>
      <insert id="InsertSysgetrows" parameterMap="insert-param">
        <generate table="Sysgetrows"/>
      </insert>
      <update id="UpdateBySysgetrows" parameterClass="Sysgetrows" >
        update SYSGETROWS set ROWNAME=#Rowname#,ROWTYPE=#Rowtype#,ROWWIDTH=#Rowwidth#,ROWENABLE=#Rowenable#,ROWEDITABLE=#Roweditable#,
        ROWAVAILLIST=#Rowavaillist#,NOURUT=#Nourut#
        where TYPENAME=#Typename# and ROWNAME=#Rownameprev#
      </update>
      <delete id="DeleteBySysgetrows" parameterMap="delete-param">
        <generate table="Sysgetrows" by="TYPENAME,ROWNAME"/>
      </delete>
      <select id="BaseQuerySysgetrows" parameterClass="Sysgetrows" resultMap="return-result">
        select rtrim(S.TYPENAME) as TYPENAME,rtrim(S.ROWNAME) as ROWNAME,rtrim(S.ROWTYPE) as ROWTYPE,S.ROWWIDTH,S.ROWENABLE,S.ROWEDITABLE,
        rtrim(S.ROWAVAILLIST) as ROWAVAILLIST,S.NOURUT
        from SYSGETROWS S
      </select>
      <select id="QueryByAllSysgetrows" extends="BaseQuerySysgetrows" parameterClass="Sysgetrows" resultMap="return-result">
        where 1=1
        and S.TYPENAME=#Typename#
        order by S.NOURUT
      </select>
      <select id="QueryByLookupSysgetrows" extends="BaseQuerySysgetrows" parameterClass="Sysgetrows" resultMap="return-result">
        where 1=1
        order by S.TYPENAME,S.ROWNAME
      </select>
      <select id="LoadByPKSysgetrows" extends="BaseQuerySysgetrows" parameterClass="Sysgetrows" resultMap="return-result">
        where S.TYPENAME = #Typename# and S.ROWNAME = #Rowname#
      </select>
    </statements>
    <parameterMaps>
      <parameterMap id="insert-param" class="Sysgetrows">
        <parameter property="Rowtype" column="ROWTYPE"/>
        <parameter property="Rowwidth" column="ROWWIDTH"/>
        <parameter property="Rowenable" column="ROWENABLE"/>
        <parameter property="Roweditable" column="ROWEDITABLE"/>
        <parameter property="Rowavaillist" column="ROWAVAILLIST"/>
        <parameter property="Nourut" column="NOURUT"/>
        <parameter property="Typename" column="TYPENAME"/>
        <parameter property="Rowname" column="ROWNAME"/>
      </parameterMap>
      <parameterMap id="update-param" extends="insert-param" class="Sysgetrows">
      </parameterMap>
      <parameterMap id="delete-param" class="Sysgetrows">
        <parameter property="Typename" column="TYPENAME"/>
        <parameter property="Rowname" column="ROWNAME"/>
      </parameterMap>
    </parameterMaps>
</sqlMap>

