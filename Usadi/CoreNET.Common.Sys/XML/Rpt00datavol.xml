    <statements>
      <insert id="InsertRpt00datavol" parameterMap="insert-param">
        <generate table="Rpt00datavol"/>
      </insert>
      <update id="UpdateByRpt00datavol" parameterMap="update-param">
        <generate table="Rpt00datavol" by="NMOBJ"/>
      </update>
      <update id="UpdateByValidRevRpt00datavol" parameterClass="Rpt00datavol">
        update RPT00DATAVOL set REV_BY=#Rev_by# and REV_DATE=#Rev_date#
      </update>
      <update id="UpdateByUnValidRevRpt00datavol" parameterClass="Rpt00datavol">
        update RPT00DATAVOL set REV_BY='' and REV_DATE=null
      </update>
      <delete id="DeleteByRpt00datavol" parameterMap="delete-param">
        <generate table="Rpt00datavol" by="NMOBJ"/>
      </delete>
      <select id="BaseQueryRpt00datavol" parameterClass="Rpt00datavol" resultMap="return-result">
        select rtrim(R.NMOBJ) as NMOBJ,R.ROW_COUNT,R.KDLEVEL,rtrim(R.TYPE) as TYPE
        from RPT00DATAVOL R
      </select>
      <select id="QueryByAllRpt00datavol" extends="BaseQueryRpt00datavol" parameterClass="Rpt00datavol" resultMap="return-result">
        where 1=1
        and (R.NMOBJ like #Nmobj#+'%' or isnull(#Nmobj#,'')='')
        order by R.NMOBJ
      </select>
      <select id="QueryByLookupRpt00datavol" extends="BaseQueryRpt00datavol" parameterClass="Rpt00datavol" resultMap="return-result">
        where 1=1
        order by R.NMOBJ
      </select>
      <select id="LoadByPKRpt00datavol" extends="BaseQueryRpt00datavol" parameterClass="Rpt00datavol" resultMap="return-result">
        where R.NMOBJ = #Nmobj#
      </select>
    </statements>
