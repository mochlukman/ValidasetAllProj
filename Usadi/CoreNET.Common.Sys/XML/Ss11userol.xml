      </resultMap>
    </resultMaps>
    <statements>
      <insert id="InsertSs11userol" parameterMap="insert-param">
        <generate table="Ss11userol"/>
      </insert>
      <update id="UpdateBySs11userol" parameterMap="update-param">
        <generate table="Ss11userol" by="IDOL"/>
      </update>
      <update id="UpdateByValidRevSs11userol" parameterClass="Ss11userol">
        update SS11USEROL set REV_BY=#Rev_by# and REV_DATE=#Rev_date#
      </update>
      <update id="UpdateByUnValidRevSs11userol" parameterClass="Ss11userol">
        update SS11USEROL set REV_BY='' and REV_DATE=null
      </update>
      <delete id="DeleteBySs11userol" parameterMap="delete-param">
        <generate table="Ss11userol" by="IDOL"/>
      </delete>
      <select id="BaseQuerySs11userol" parameterClass="Ss11userol" resultMap="return-result">
        select rtrim(S.IDOL) as IDOL,rtrim(S.USERKEY) as USERKEY,rtrim(S.USERID) as USERID,rtrim(S.USERCOMP) as USERCOMP,
        rtrim(S.USERIP) as USERIP,rtrim(S.USERBROWSER) as USERBROWSER,S.STATUS,rtrim(isnull(S.LAST_BY,'')) as LAST_BY,S.LAST_DATE,
        rtrim(U.USERTYPE) as USERTYPE,rtrim(U.USERNAMA) as USERNAMA,
        rtrim(U.USERBLOCK) as USERBLOCK,rtrim(U.USERNIP) as USERNIP,
        rtrim(U.USERHP) as USERHP,rtrim(U.USEREMAIL) as USEREMAIL,U.USERNO,
        rtrim(U.USERURAIAN) as USERURAIAN,U.USERSTATUS,rtrim(U.USERKET) as USERKET
        from SS11USEROL S
        inner join SS10USER U on S.USERID=U.USERID
      </select>
      <select id="QueryByAllSs11userol" extends="BaseQuerySs11userol" parameterClass="Ss11userol" resultMap="return-result">
        where 1=1
        and S.IDAPP=#Idapp#
        order by S.IDOL
      </select>
      <select id="QueryByLookupSs11userol" extends="BaseQuerySs11userol" parameterClass="Ss11userol" resultMap="return-result">
        where 1=1
        order by S.IDOL
      </select>
      <select id="LoadByPKSs11userol" extends="BaseQuerySs11userol" parameterClass="Ss11userol" resultMap="return-result">
        where S.IDOL = #Idol#
      </select>
    </statements>
    <parameterMaps>
      <parameterMap id="insert-param" class="Ss11userol">
