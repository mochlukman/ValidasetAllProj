<?xml version="1.0" encoding="utf-8" ?>
<sqlMap namespace="Ss11userol" xmlns="http://ibatis.apache.org/mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <alias>
      <typeAlias alias="Ss11userol" type="CoreNET.Common.BO.Ss10userControl" />
    </alias>
    <resultMaps>
      <resultMap id="return-result" class="Ss11userol">
        <result property="Usertype" column="USERTYPE"/>
