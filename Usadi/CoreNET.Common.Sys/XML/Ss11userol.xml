        <parameter property="Idol" column="IDOL"/>
      </parameterMap>
      <parameterMap id="update-param" extends="insert-param" class="Ss11userol">
      </parameterMap>
      <parameterMap id="delete-param" class="Ss11userol">
        <parameter property="Idol" column="IDOL"/>
      </parameterMap>
    </parameterMaps>
</sqlMap>

