<?xml version="1.0" encoding="utf-8" ?>
<sqlMap namespace="Ss20groupuser" xmlns="http://ibatis.apache.org/mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <alias>
      <typeAlias alias="Ss20groupuser" type="CoreNET.Common.BO.Ss20groupuserControl, CoreNET.Common.Sys " />
    </alias>
    <resultMaps>
      <resultMap id="return-result" class="Ss20groupuser">
        <result property="Status" column="STATUS"/>
        <result property="Last_by" column="LAST_BY"/>
        <result property="Last_date" column="LAST_DATE"/>
        <result property="Usernip" column="USERNIP"/>
        <result property="Userhp" column="USERHP"/>
        <result property="Useremail" column="USEREMAIL"/>
        <result property="Useruraian" column="USERURAIAN"/>
        <result property="Userid" column="USERID"/>
        <result property="Kdgroup" column="KDGROUP"/>
      </resultMap>
      <resultMap id="return-result-lookup" class="Ss20groupuser">
        <result property="Usernip" column="USERNIP"/>
        <result property="Userhp" column="USERHP"/>
        <result property="Useremail" column="USEREMAIL"/>
        <result property="Useruraian" column="USERURAIAN"/>
        <result property="Userid" column="USERID"/>
      </resultMap>
    </resultMaps>
    <statements>
      <insert id="InsertSs20groupuser" parameterMap="insert-param">
        <generate table="SS20GROUPUSER"/>
      </insert>
      <update id="UpdateBySs20groupuser" parameterMap="update-param">
        <generate table="SS20GROUPUSER" by="USERID,KDGROUP"/>
      </update>
      <update id="UpdateByValidRevSs20groupuser" parameterClass="Ss20groupuser">
        update SS20GROUPUSER set REV_BY=#Rev_by#,REV_DATE=#Rev_date#
        where 1=1
      </update>
      <update id="UpdateByUnValidRevSs20groupuser" parameterClass="Ss20groupuser">
        update SS20GROUPUSER set REV_BY='',REV_DATE=null
        where 1=1
      </update>
      <delete id="DeleteBySs20groupuser" parameterMap="delete-param">
        <generate table="SS20GROUPUSER" by="USERID,KDGROUP"/>
      </delete>
      <select id="BaseQuerySs20groupuser" parameterClass="Ss20groupuser" resultMap="return-result">
        select rtrim(S.USERID) as USERID,rtrim(S.KDGROUP) as KDGROUP
        ,S.STATUS,rtrim(isnull(S.LAST_BY,'')) as LAST_BY,S.LAST_DATE
        ,rtrim(U.USERNAMA) as USERNAMA,rtrim(U.USERNIP) as USERNIP,rtrim(U.USERHP) as USERHP
        ,rtrim(U.USEREMAIL) as USEREMAIL,rtrim(U.USERURAIAN) as USERURAIAN
        from SS20GROUPUSER S
        inner join SS10USER U on S.USERID=U.USERID
      </select>
      <select id="QueryByAllSs20groupuser" extends="BaseQuerySs20groupuser" parameterClass="Ss20groupuser" resultMap="return-result">
        where 1=1
        and S.KDGROUP=#Kdgroup#
        order by S.USERID,S.KDGROUP
      </select>
      <select id="QueryByLookupSs20groupuser" extends="BaseQuerySs20groupuser" parameterClass="Ss20groupuser" resultMap="return-result">
        where 1=1
        order by S.USERID,S.KDGROUP
      </select>
      <select id="QueryByLookupForSelfSs20groupuser" parameterClass="Ss20groupuser" resultMap="return-result-lookup">
        select rtrim(S.USERID) as USERID,rtrim(S.USERTYPE) as USERTYPE
        ,rtrim(S.USERNAMA) as USERNAMA,rtrim(S.USERNIP) as USERNIP,rtrim(S.USERHP) as USERHP
        ,rtrim(S.USEREMAIL) as USEREMAIL,rtrim(S.USERURAIAN) as USERURAIAN
        from SS10USER S
        where 1=1
        and S.USERID not in (select USERID from SS20GROUPUSER where KDGROUP=#Kdgroup#)
      </select>
      <select id="LoadByPKSs20groupuser" extends="BaseQuerySs20groupuser" parameterClass="Ss20groupuser" resultMap="return-result">
        where S.USERID = #Userid# and S.KDGROUP = #Kdgroup#
      </select>
      <select id="LoadByIDSs20groupuser" extends="BaseQuerySs20groupuser" parameterClass="Ss20groupuser" resultMap="return-result">
        where S.USERID = #Userid# and S.KDGROUP = #Kdgroup#
      </select>
    </statements>
    <parameterMaps>
      <parameterMap id="insert-param" class="Ss20groupuser">
        <parameter property="Status" column="STATUS"/>
        <parameter property="Last_by" column="LAST_BY"/>
        <parameter property="Last_date" column="LAST_DATE"/>
        <parameter property="Userid" column="USERID"/>
        <parameter property="Kdgroup" column="KDGROUP"/>
      </parameterMap>
      <parameterMap id="update-param" extends="insert-param" class="Ss20groupuser">
      </parameterMap>
      <parameterMap id="delete-param" class="Ss20groupuser">
        <parameter property="Userid" column="USERID"/>
        <parameter property="Kdgroup" column="KDGROUP"/>
      </parameterMap>
    </parameterMaps>
</sqlMap>

