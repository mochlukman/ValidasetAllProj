<?xml version="1.0" encoding="utf-8" ?>
<sqlMap namespace="Ss10usertypes" xmlns="http://ibatis.apache.org/mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <alias>
      <typeAlias alias="Ss10usertypes" type="CoreNET.Common.BO.Ss10userControl" />
    </alias>
    <resultMaps>
      <resultMap id="return-result" class="Ss10usertypes">
        <result property="Uturaian" column="UTURAIAN"/>
        <result property="Status" column="STATUS"/>
        <result property="Last_by" column="LAST_BY"/>
        <result property="Last_date" column="LAST_DATE"/>
        <result property="Usertype" column="USERTYPE"/>
      </resultMap>
    </resultMaps>
    <statements>
      <insert id="InsertSs10usertypes" parameterMap="insert-param">
        <generate table="Ss10usertypes"/>
      </insert>
      <update id="UpdateBySs10usertypes" parameterMap="update-param">
        <generate table="Ss10usertypes" by="USERTYPE"/>
      </update>
      <update id="UpdateByValidRevSs10usertypes" parameterClass="Ss10usertypes">
        update SS10USERTYPES set REV_BY=#Rev_by# and REV_DATE=#Rev_date#
      </update>
      <update id="UpdateByUnValidRevSs10usertypes" parameterClass="Ss10usertypes">
        update SS10USERTYPES set REV_BY='' and REV_DATE=null
      </update>
      <delete id="DeleteBySs10usertypes" parameterMap="delete-param">
        <generate table="Ss10usertypes" by="USERTYPE"/>
      </delete>
      <select id="BaseQuerySs10usertypes" parameterClass="Ss10usertypes" resultMap="return-result">
        select rtrim(S.USERTYPE) as USERTYPE,rtrim(S.UTURAIAN) as UTURAIAN,S.STATUS,rtrim(isnull(S.LAST_BY,'')) as LAST_BY,S.LAST_DATE
        from SS10USERTYPES S
      </select>
      <select id="QueryByAllSs10usertypes" extends="BaseQuerySs10usertypes" parameterClass="Ss10usertypes" resultMap="return-result">
        where 1=1
        and S.USERTYPE not in ('A','D','T')
        order by S.USERTYPE
      </select>
      <select id="QueryByLookupSs10usertypes" extends="BaseQuerySs10usertypes" parameterClass="Ss10usertypes" resultMap="return-result">
        where 1=1
        order by S.USERTYPE
      </select>
      <select id="LoadByPKSs10usertypes" extends="BaseQuerySs10usertypes" parameterClass="Ss10usertypes" resultMap="return-result">
        where S.USERTYPE = #Usertype#
      </select>
    </statements>
    <parameterMaps>
      <parameterMap id="insert-param" class="Ss10usertypes">
        <parameter property="Uturaian" column="UTURAIAN"/>
        <parameter property="Status" column="STATUS"/>
        <parameter property="Last_by" column="LAST_BY"/>
        <parameter property="Last_date" column="LAST_DATE"/>
        <parameter property="Usertype" column="USERTYPE"/>
      </parameterMap>
      <parameterMap id="update-param" extends="insert-param" class="Ss10usertypes">
      </parameterMap>
      <parameterMap id="delete-param" class="Ss10usertypes">
        <parameter property="Usertype" column="USERTYPE"/>
      </parameterMap>
    </parameterMaps>
</sqlMap>

