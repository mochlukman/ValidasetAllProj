      </delete>
      <select id="BaseQuerySs30roleparam" parameterClass="Ss30roleparam" resultMap="return-result">
        select rtrim(S.PAR) as PAR,rtrim(S.DESCIPTION) as DESCIPTION,rtrim(S.LAST_BY) as LAST_BY,S.LAST_DATE
        from SS30ROLEPARAM S
      </select>
      <select id="QueryByAllSs30roleparam" extends="BaseQuerySs30roleparam" parameterClass="Ss30roleparam" resultMap="return-result">
        where 1=1
        order by S.PAR
      </select>
      <select id="QueryByLookupSs30roleparam" extends="BaseQuerySs30roleparam" parameterClass="Ss30roleparam" resultMap="return-result">
        where 1=1
        order by S.PAR
      </select>
      <select id="LoadByPKSs30roleparam" extends="BaseQuerySs30roleparam" parameterClass="Ss30roleparam" resultMap="return-result">
