      <select id="BaseQuerySs01appmenuconfig" parameterClass="Ss01appmenuconfig" resultMap="return-result">
        select rtrim(S.IDMENU) as IDMENU,rtrim(S.PAR) as PAR,rtrim(S.VALUE) as VALUE,S.STATUS,rtrim(isnull(S.LAST_BY,'')) as LAST_BY,S.LAST_DATE
