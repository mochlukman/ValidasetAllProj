<?xml version="1.0" encoding="utf-8" ?>
<sqlMap namespace="Ss20group" xmlns="http://ibatis.apache.org/mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <alias>
      <typeAlias alias="Ss20group" type="CoreNET.Common.BO.Ss20groupControl, CoreNET.Common.Sys " />
    </alias>
    <resultMaps>
      <resultMap id="return-result" class="Ss20group">
        <result property="Nmgroup" column="NMGROUP"/>
        <result property="Urgroup" column="URGROUP"/>
        <result property="Status" column="STATUS"/>
        <result property="Kdlevel" column="KDLEVEL"/>
        <result property="Type" column="TYPE"/>
        <result property="Last_by" column="LAST_BY"/>
        <result property="Last_date" column="LAST_DATE"/>
        <result property="Kdgroup" column="KDGROUP"/>
      </resultMap>
      <resultMap id="return-result-app" class="Ss20group">
        <result property="Idapp" column="IDAPP"/>
        <result property="Kdapp" column="KDAPP"/>
        <result property="Nmapp" column="NMAPP"/>
        <result property="Urapp" column="URAPP"/>
      </resultMap>
    </resultMaps>
    <statements>
      <insert id="InsertSs20group" parameterMap="insert-param">
        <generate table="SS20GROUP"/>
      </insert>
      <update id="UpdateBySs20group" parameterMap="update-param">
        <generate table="SS20GROUP" by="KDGROUP"/>
      </update>
      <update id="UpdateByValidRevSs20group" parameterClass="Ss20group">
        update SS20GROUP set REV_BY=#Rev_by#,REV_DATE=#Rev_date#
        where 1=1
      </update>
      <update id="UpdateByUnValidRevSs20group" parameterClass="Ss20group">
        update SS20GROUP set REV_BY='',REV_DATE=null
        where 1=1
      </update>
      <delete id="DeleteBySs20group" parameterMap="delete-param">
        <generate table="SS20GROUP" by="KDGROUP"/>
      </delete>
      <select id="BaseQuerySs20group" parameterClass="Ss20group" resultMap="return-result">
        select rtrim(S.KDGROUP) as KDGROUP,rtrim(S.NMGROUP) as NMGROUP,rtrim(S.URGROUP) as URGROUP,S.STATUS,S.KDLEVEL,rtrim(S.TYPE) as TYPE,rtrim(isnull(S.LAST_BY,'')) as LAST_BY,S.LAST_DATE
        from SS20GROUP S
      </select>
      <select id="QueryByAllSs20group" extends="BaseQuerySs20group" parameterClass="Ss20group" resultMap="return-result">
        where 1=1
        order by S.KDGROUP
      </select>
      <select id="QueryByLookupSs20group" extends="BaseQuerySs20group" parameterClass="Ss20group" resultMap="return-result">
        where 1=1
        order by S.KDGROUP
      </select>
      <select id="QueryByAppSs20group" parameterClass="Ss20group" resultMap="return-result-app">
        select rtrim(S.KDAPP) as KDAPP,rtrim(S.NMAPP) as NMAPP,rtrim(S.URAPP) as URAPP,rtrim(S.IDAPP) as IDAPP
        from SS00APP S
        where 1=1
        and IDAPP in (
          select IDAPP from SS01APPMENU where IDMENU in (
            select IDMENU from SS20GROUPMENU where KDGROUP=#Kdgroup#
          )
        )
      </select>
      <select id="LoadByPKSs20group" extends="BaseQuerySs20group" parameterClass="Ss20group" resultMap="return-result">
        where S.KDGROUP = #Kdgroup#
      </select>
      <select id="LoadByIDSs20group" extends="BaseQuerySs20group" parameterClass="Ss20group" resultMap="return-result">
        where S.KDGROUP = #Kdgroup#
      </select>
    </statements>
    <parameterMaps>
      <parameterMap id="insert-param" class="Ss20group">
        <parameter property="Nmgroup" column="NMGROUP"/>
        <parameter property="Urgroup" column="URGROUP"/>
        <parameter property="Status" column="STATUS"/>
        <parameter property="Kdlevel" column="KDLEVEL"/>
        <parameter property="Type" column="TYPE"/>
        <parameter property="Last_by" column="LAST_BY"/>
        <parameter property="Last_date" column="LAST_DATE"/>
        <parameter property="Kdgroup" column="KDGROUP"/>
      </parameterMap>
      <parameterMap id="update-param" extends="insert-param" class="Ss20group">
      </parameterMap>
      <parameterMap id="delete-param" class="Ss20group">
        <parameter property="Kdgroup" column="KDGROUP"/>
      </parameterMap>
    </parameterMaps>
</sqlMap>

