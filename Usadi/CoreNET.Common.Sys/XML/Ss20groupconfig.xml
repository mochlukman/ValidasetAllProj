<?xml version="1.0" encoding="utf-8" ?>
<sqlMap namespace="Ss20groupconfig" xmlns="http://ibatis.apache.org/mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <alias>
      <typeAlias alias="Ss20groupconfig" type="CoreNET.Common.BO.Ss20groupconfigControl, CoreNET.Common.Sys " />
    </alias>
    <resultMaps>
      <resultMap id="return-result" class="Ss20groupconfig">
        <result property="Value" column="VALUE"/>
        <result property="Last_by" column="LAST_BY"/>
        <result property="Last_date" column="LAST_DATE"/>
        <result property="Kdgroup" column="KDGROUP"/>
        <result property="Par" column="PAR"/>
      </resultMap>
    </resultMaps>
    <statements>
      <insert id="InsertSs20groupconfig" parameterMap="insert-param">
        <generate table="SS20GROUPCONFIG"/>
      </insert>
      <update id="UpdateBySs20groupconfig" parameterMap="update-param">
        <generate table="SS20GROUPCONFIG" by="KDGROUP,PAR"/>
      </update>
      <update id="UpdateByValidRevSs20groupconfig" parameterClass="Ss20groupconfig">
        update SS20GROUPCONFIG set REV_BY=#Rev_by#,REV_DATE=#Rev_date#
        where 1=1
      </update>
      <update id="UpdateByUnValidRevSs20groupconfig" parameterClass="Ss20groupconfig">
        update SS20GROUPCONFIG set REV_BY='',REV_DATE=null
        where 1=1
      </update>
      <delete id="DeleteBySs20groupconfig" parameterMap="delete-param">
        <generate table="SS20GROUPCONFIG" by="KDGROUP,PAR"/>
      </delete>
      <select id="BaseQuerySs20groupconfig" parameterClass="Ss20groupconfig" resultMap="return-result">
        select rtrim(S.KDGROUP) as KDGROUP,rtrim(S.PAR) as PAR,rtrim(S.VALUE) as VALUE,rtrim(isnull(S.LAST_BY,'')) as LAST_BY,S.LAST_DATE
        from SS20GROUPCONFIG S
      </select>
      <select id="QueryByAllSs20groupconfig" extends="BaseQuerySs20groupconfig" parameterClass="Ss20groupconfig" resultMap="return-result">
        where 1=1
        order by S.KDGROUP,S.PAR
      </select>
      <select id="QueryByLookupSs20groupconfig" extends="BaseQuerySs20groupconfig" parameterClass="Ss20groupconfig" resultMap="return-result">
        where 1=1
        order by S.KDGROUP,S.PAR
      </select>
      <select id="LoadByPKSs20groupconfig" extends="BaseQuerySs20groupconfig" parameterClass="Ss20groupconfig" resultMap="return-result">
        where S.KDGROUP = #Kdgroup# and S.PAR = #Par#
      </select>
      <select id="LoadByIDSs20groupconfig" extends="BaseQuerySs20groupconfig" parameterClass="Ss20groupconfig" resultMap="return-result">
        where S.KDGROUP = #Kdgroup# and S.PAR = #Par#
      </select>
    </statements>
    <parameterMaps>
      <parameterMap id="insert-param" class="Ss20groupconfig">
        <parameter property="Value" column="VALUE"/>
        <parameter property="Last_by" column="LAST_BY"/>
        <parameter property="Last_date" column="LAST_DATE"/>
        <parameter property="Kdgroup" column="KDGROUP"/>
        <parameter property="Par" column="PAR"/>
      </parameterMap>
      <parameterMap id="update-param" extends="insert-param" class="Ss20groupconfig">
      </parameterMap>
      <parameterMap id="delete-param" class="Ss20groupconfig">
        <parameter property="Kdgroup" column="KDGROUP"/>
        <parameter property="Par" column="PAR"/>
      </parameterMap>
    </parameterMaps>
</sqlMap>

