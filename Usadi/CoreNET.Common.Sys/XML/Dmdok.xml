      </delete>
      <select id="BaseQueryDmdok" parameterClass="Dmdok" resultMap="return-result">
        select rtrim(D.KDDOK) as KDDOK,rtrim(D.NMDOK) as NMDOK,rtrim(D.LBLDOK) as LBLDOK,rtrim(D.KDPERSPPKD) as KDPERSPPKD,rtrim(D.KDPERSSKPD) as KDPERSSKPD,D.STATUS,D.KDLEVEL,rtrim(D.TYPE) as TYPE,rtrim(D.LAST_BY) as LAST_BY,D.LAST_DATE
        from DMDOK D
      </select>
      <select id="QueryByAllDmdok" extends="BaseQueryDmdok" parameterClass="Dmdok" resultMap="return-result">
        where 1=1
        order by D.KDDOK
      </select>
      <select id="QueryByLookupDmdok" extends="BaseQueryDmdok" parameterClass="Dmdok" resultMap="return-result">
        where 1=1
