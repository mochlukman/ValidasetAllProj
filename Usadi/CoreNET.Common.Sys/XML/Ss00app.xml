<?xml version="1.0" encoding="utf-8" ?>
<sqlMap namespace="Ss00app" xmlns="http://ibatis.apache.org/mapping" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <alias>
      <typeAlias alias="Ss00app" type="CoreNET.Common.BO.SsappControl, CoreNET.Common.Data" />
    </alias>
    <resultMaps>
      <resultMap id="return-result" class="Ss00app">
        <result property="Url" column="URL"/>
        <result property="UrlFull" column="URLFULL"/>
        <result property="Nmapp" column="NMAPP"/>
        <result property="Urapp" column="URAPP"/>
        <result property="Idapp" column="IDAPP"/>
        <result property="Status" column="STATUS"/>
        <result property="Kdlevel" column="KDLEVEL"/>
        <result property="Type" column="TYPE"/>
        <result property="Last_by" column="LAST_BY"/>
        <result property="Last_date" column="LAST_DATE"/>
        <result property="Kdapp" column="KDAPP"/>
      </resultMap>
    </resultMaps>
    <statements>
      <insert id="InsertSs00app" parameterMap="insert-param">
        <generate table="Ss00app"/>
      </insert>
      <update id="UpdateBySs00app" parameterMap="update-param">
        <generate table="Ss00app" by="KDAPP"/>
      </update>
      <update id="UpdateByValidRevSs00app" parameterClass="Ss00app">
        update SS00APP set REV_BY=#Rev_by# and REV_DATE=#Rev_date#
      </update>
      <update id="UpdateByUnValidRevSs00app" parameterClass="Ss00app">
        update SS00APP set REV_BY='' and REV_DATE=null
      </update>
      <delete id="DeleteBySs00app" parameterMap="delete-param">
        <generate table="Ss00app" by="KDAPP"/>
      </delete>
      <select id="BaseQuerySs00app" parameterClass="Ss00app" resultMap="return-result">
        select rtrim(S.KDAPP) as KDAPP,rtrim(S.NMAPP) as NMAPP,rtrim(S.URAPP) as URAPP
        ,rtrim(S.URL) as URL
        ,case S.URL when '' then '' else rtrim(S.URL)+'&amp;kdapp='+rtrim(S.KDAPP) end as URLFULL,
        rtrim(S.IDAPP) as IDAPP,
        S.STATUS,S.KDLEVEL,rtrim(S.TYPE) as TYPE,
        rtrim(isnull(S.LAST_BY,'')) as LAST_BY,S.LAST_DATE
        from SS00APP S
      </select>
      <select id="QueryByAllSs00app" extends="BaseQuerySs00app" parameterClass="Ss00app" resultMap="return-result">
        where 1=1
        and
          (
            (isnull(#Kdapp#,'')='')
            or
            (left(S.KDAPP,2)=left(#Kdapp#,2) and (len(rtrim(S.KDAPP))=3))
            or
            (left(S.KDAPP,len(#Kdapp#))=left(#Kdapp#,len(#Kdapp#)))
          )
        order by S.KDAPP
      </select>
      <select id="QueryByLookupSs00app" extends="BaseQuerySs00app" parameterClass="Ss00app" resultMap="return-result">
        where 1=1
        order by S.KDAPP
      </select>
      <select id="QueryByLookupByUseridSs00app" extends="BaseQuerySs00app" parameterClass="Ss00app" resultMap="return-result">
        where 1=1
        and (S.IDAPP not in (select IDAPP from SS10USERAPP where USERID=#Userid#) or S.TYPE='H')
        order by S.KDAPP
      </select>
      <select id="LoadByPKSs00app" extends="BaseQuerySs00app" parameterClass="Ss00app" resultMap="return-result">
        where S.KDAPP = #Kdapp#
      </select>
      <select id="LoadByIDSs00app" extends="BaseQuerySs00app" parameterClass="Ss00app" resultMap="return-result">
        where S.IDAPP = #Idapp#
      </select>
    </statements>
    <parameterMaps>
      <parameterMap id="insert-param" class="Ss00app">
        <parameter property="Url" column="URL"/>
        <parameter property="Nmapp" column="NMAPP"/>
        <parameter property="Urapp" column="URAPP"/>
        <parameter property="Idapp" column="IDAPP"/>
        <parameter property="Status" column="STATUS"/>
        <parameter property="Kdlevel" column="KDLEVEL"/>
        <parameter property="Type" column="TYPE"/>
        <parameter property="Last_by" column="LAST_BY"/>
        <parameter property="Last_date" column="LAST_DATE"/>
        <parameter property="Kdapp" column="KDAPP"/>
      </parameterMap>
      <parameterMap id="update-param" extends="insert-param" class="Ss00app">
      </parameterMap>
      <parameterMap id="delete-param" class="Ss00app">
        <parameter property="Kdapp" column="KDAPP"/>
      </parameterMap>
    </parameterMaps>
</sqlMap>

