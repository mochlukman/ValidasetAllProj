        <parameter property="Emailpemda" column="EMAILPEMDA"/>
        <parameter property="Kdblok" column="KDBLOK"/>
        <parameter property="Aktif" column="AKTIF"/>
        <parameter property="Status" column="STATUS"/>
        <parameter property="Kdlevel" column="KDLEVEL"/>
        <parameter property="Type" column="TYPE"/>
        <parameter property="Last_by" column="LAST_BY"/>
        <parameter property="Last_date" column="LAST_DATE"/>
        <parameter property="Kdpemda" column="KDPEMDA"/>
      </parameterMap>
      <parameterMap id="update-param" extends="insert-param" class="Dmpemda">
